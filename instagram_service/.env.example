# Copy this file to .env (same folder) and fill in your real values.
# .env should NOT be committed to git or shared — it contains secrets.

IG_ACCESS_TOKEN=your-long-lived-access-token-here
IG_USER_ID=your-instagram-business-account-numeric-id-here

# Only needed if you're using auth.py's exchange/refresh functions.
# For Business Login for Instagram (tokens starting with "IGAA"), only
# the app secret is required — FB_APP_ID is not used in that flow.
FB_APP_SECRET=your-instagram-app-secret-here
